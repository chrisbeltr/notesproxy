<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <IncludeNativeLibrariesForSelfContained>true</IncludeNativeLibrariesForSelfContained>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\NotesProxy.Manager\NotesProxy.Manager.csproj" />
      <ProjectReference Include="..\NotesProxy.Tui\NotesProxy.Tui.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Spectre.Console.Cli" Version="0.55.1-alpha.0.7" />
    </ItemGroup>

</Project>
